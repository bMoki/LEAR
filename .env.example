# Copie para .env.local e preencha. Ver docs/plano-cms-headless.md §13.
# O .gitignore ignora .env* e libera só este arquivo.

# Projeto Sanity — visíveis no navegador (o dataset é público no plano gratuito).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Versão da API do Sanity, travada por data. Só mude conscientemente.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-04

# Segredo do webhook de revalidação (/api/revalidate). Gere um valor aleatório
# e cadastre o mesmo em Sanity Manage > API > Webhooks.
SANITY_WEBHOOK_SECRET=

# Token com permissão de escrita. SÓ local, SÓ para rodar scripts/seed.ts uma
# vez. Não configure em produção.
SANITY_WRITE_TOKEN=

# --- Formulário de contato (lib/contact/action.ts) ---
# As três são obrigatórias juntas: faltando qualquer uma, o formulário recusa o
# envio e registra o motivo no log do servidor. Nenhuma tem prefixo
# NEXT_PUBLIC_ — elas ficam no servidor e não podem entrar no bundle.

# Chave da API do Resend (https://resend.com — o plano gratuito basta).
RESEND_API_KEY=

# Caixa que recebe as mensagens do formulário.
CONTACT_TO_EMAIL=

# Remetente. Precisa ser de um domínio verificado no Resend; enquanto o domínio
# do laboratório não estiver verificado, `onboarding@resend.dev` funciona para
# testar, mas só entrega para o e-mail dono da conta Resend.
CONTACT_FROM_EMAIL=
