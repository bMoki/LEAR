# Copie para .env.local e preencha. Ver docs/plano-cms-headless.md §13.
# O .gitignore ignora .env* e libera só este arquivo.

# --- Endereço do site (lib/seo/site.ts) ---
# Fica VAZIO enquanto o domínio não existir: sem valor, tudo cai em
# http://localhost:3000 e o build roda em qualquer máquina. Quando o endereço
# definitivo for escolhido (ver PENDENCIAS.md), esta é a única linha a mudar —
# canonical, og:url, sitemap.xml e robots.txt derivam dela.
# Sem barra no fim. Ex.: https://lear.biologia.ufrj.br
NEXT_PUBLIC_SITE_URL=

# Libera a indexação pelos buscadores. Vazio = NÃO indexa, e é o padrão certo:
# vale "true" num lugar só, o ambiente de produção, e só depois que o domínio
# definitivo estiver respondendo.
#
# Enquanto o site estiver num endereço provisório (<projeto>.vercel.app, preview
# de branch), deixe vazio. Indexar um endereço provisório custa caro de desfazer:
# depois de indexado, trocar de endereço vira migração de domínio.
#
# Preencha NEXT_PUBLIC_SITE_URL com o endereço provisório mesmo assim — é ele
# que faz o canonical e o card social ficarem certos no link que você manda para
# o cliente revisar.
NEXT_PUBLIC_ALLOW_INDEXING=

# Projeto Sanity — visíveis no navegador (o dataset é público no plano gratuito).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Versão da API do Sanity, travada por data. Só mude conscientemente.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-04

# Segredo do webhook de revalidação (/api/revalidate). Gere um valor aleatório
# e cadastre o mesmo em Sanity Manage > API > Webhooks.
SANITY_WEBHOOK_SECRET=

# Token com permissão de escrita. SÓ local, SÓ para os scripts de scripts/wp/
# (a importação do site antigo, ADR 0006). Não configure em produção — o site
# lê o dataset sem autenticação, e o Studio usa a sessão de quem está logado.
SANITY_WRITE_TOKEN=

# --- Formulário de contato (lib/contact/action.ts) ---
# As três são obrigatórias juntas: faltando qualquer uma, o formulário recusa o
# envio e registra o motivo no log do servidor. Nenhuma tem prefixo
# NEXT_PUBLIC_ — elas ficam no servidor e não podem entrar no bundle.

# Chave da API do Resend (https://resend.com — o plano gratuito basta).
RESEND_API_KEY=

# Caixa que recebe as mensagens do formulário.
CONTACT_TO_EMAIL=

# Remetente. Precisa ser de um domínio verificado no Resend; enquanto o domínio
# do laboratório não estiver verificado, `onboarding@resend.dev` funciona para
# testar, mas só entrega para o e-mail dono da conta Resend.
CONTACT_FROM_EMAIL=
